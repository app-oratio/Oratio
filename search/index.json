---
layout: null
permalink: /search/index.json
search: false
sitemap: false
---
{% assign search_documents = site.pages
  | concat: site.posts
  | concat: site.oracoes
  | concat: site.novenas
  | concat: site.quaresmas
  | concat: site.trintenas
  | concat: site.devocoes_mensais
  | concat: site.trezenas
  | concat: site.triduos
  | concat: site.tercos
  | concat: site.rosarios
  | concat: site.coroas
  | concat: site.devocionarios
  | concat: site.santos
  | concat: site.formacoes %}
{% assign search_documents = search_documents | where_exp: 'item', 'item.search != false' %}
[
  {% assign first_search_record = true %}
  {% for item in search_documents %}
    {% unless first_search_record %},{% endunless %}
    {% capture searchable_content %}
      {{ item.content | markdownify | strip_html }}
      {% include search-devotional-text.html document=item %}
      {% if item.collection == 'santos' %}
        {{ item.short_title }}
        {{ item.subtitle }}
        {{ item.saint_type }}
        {{ item.religious_family }}
        {{ item.liturgical_rank }}
        {{ item.liturgical_memorial }}
        {{ item.aliases | join: ' ' }}
        {{ item.patronages | join: ' ' }}
        {{ item.virtues | join: ' ' }}
      {% endif %}
      {% case item.collection %}
        {% when 'novenas', 'quaresmas', 'trintenas', 'devocoes_mensais', 'trezenas', 'triduos' %}
          {% assign modern_search_days = site.dias_novena | where: 'devotion', item.slug %}
          {% assign legacy_search_days = site.dias_novena | where: 'novena', item.slug %}
          {% assign child_search_days = legacy_search_days | concat: modern_search_days | sort: 'day' %}
          {% for child_day in child_search_days %}
            {{ child_day.title }}
            {{ child_day.theme }}
            {{ child_day.description }}
            {{ child_day.content | markdownify | strip_html }}
            {% include search-devotional-text.html document=child_day %}
          {% endfor %}
      {% endcase %}
    {% endcapture %}
    {% capture item_type %}{% case item.collection %}{% when 'posts' %}Blog{% when 'oracoes' %}Oração{% when 'novenas' %}Novena{% when 'quaresmas' %}Quaresma{% when 'trintenas' %}Trintena{% when 'devocoes_mensais' %}Devoção mensal{% when 'trezenas' %}Trezena{% when 'triduos' %}Tríduo{% when 'tercos' %}Terço{% when 'rosarios' %}Rosário{% when 'coroas' %}Coroa{% when 'santos' %}Santo{% when 'devocionarios' %}Devocionário{% when 'formacoes' %}Formação{% else %}Página{% endcase %}{% endcapture %}
    {
      "title": {{ item.title | default: site.title | jsonify }},
      "description": {{ item.description | default: item.excerpt | strip_html | strip_newlines | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "type": {{ item.search_type | default: item_type | strip | jsonify }},
      "category": {{ item.category | default: item.categories.first | jsonify }},
      "tags": {{ item.tags | default: empty | jsonify }},
      "keywords": {{ item.keywords | default: empty | jsonify }},
      "aliases": {{ item.aliases | default: empty | jsonify }},
      "excerpt": {{ searchable_content | normalize_whitespace | truncate: 320 | jsonify }},
      "searchText": {{ searchable_content | normalize_whitespace | jsonify }},
      "searchScope": {% case item.collection %}{% when 'novenas', 'quaresmas', 'trintenas', 'devocoes_mensais', 'trezenas', 'triduos' %}"Inclui o texto de todos os dias"{% else %}null{% endcase %},
      "image": {{ item.image | jsonify }}
    }
    {% assign first_search_record = false %}
  {% endfor %}

  {% for book in site.data.bible_books %}
    {% capture bible_book_description %}Leia o livro de {{ book.name }} na Bíblia Sagrada, tradução Matos Soares.{% endcapture %}
    {% capture bible_book_search_text %}Bíblia Sagrada livro {{ book.name }} {{ book.short_name }} {{ book.aliases | join: ' ' }} {{ book.testament }} {{ book.section }} {{ book.chapters }} capítulos Matos Soares{% endcapture %}
    {% unless first_search_record %},{% endunless %}
    {
      "title": {{ book.name | jsonify }},
      "description": {{ bible_book_description | strip | jsonify }},
      "url": {{ '/biblia/' | append: book.slug | append: '/' | relative_url | jsonify }},
      "type": "Bíblia · Livro",
      "category": {{ book.testament | jsonify }},
      "tags": [{{ book.section | jsonify }}, "Bíblia Sagrada"],
      "keywords": {{ book.aliases | jsonify }},
      "aliases": {{ book.aliases | jsonify }},
      "excerpt": {{ bible_book_search_text | normalize_whitespace | truncate: 320 | jsonify }},
      "searchText": {{ bible_book_search_text | normalize_whitespace | jsonify }},
      "searchScope": "Livro e capítulos",
      "image": {{ '/assets/images/social/og-default.webp' | relative_url | jsonify }}
    }
    {% assign first_search_record = false %}
    {% for chapter_number in (1..book.chapters) %}
      {% capture bible_chapter_description %}Leia {{ book.name }}, capítulo {{ chapter_number }}, na Bíblia Sagrada, tradução Matos Soares.{% endcapture %}
      {% capture bible_chapter_search_text %}Bíblia Sagrada {{ book.name }} capítulo {{ chapter_number }} {{ book.short_name }} {{ chapter_number }} {{ book.aliases | join: ' ' }} {{ book.testament }} {{ book.section }} Matos Soares{% endcapture %},
      {
        "title": {{ book.name | append: ' ' | append: chapter_number | jsonify }},
        "description": {{ bible_chapter_description | strip | jsonify }},
        "url": {{ '/biblia/' | append: book.slug | append: '/' | append: chapter_number | append: '/' | relative_url | jsonify }},
        "type": "Bíblia · Capítulo",
        "category": {{ book.testament | jsonify }},
        "tags": [{{ book.section | jsonify }}, "Bíblia Sagrada"],
        "keywords": {{ book.aliases | jsonify }},
        "aliases": {{ book.aliases | jsonify }},
        "excerpt": {{ bible_chapter_search_text | normalize_whitespace | truncate: 320 | jsonify }},
        "searchText": {{ bible_chapter_search_text | normalize_whitespace | jsonify }},
        "searchScope": "Capítulo bíblico",
        "image": {{ '/assets/images/social/og-default.webp' | relative_url | jsonify }}
      }
    {% endfor %}
  {% endfor %}
]
