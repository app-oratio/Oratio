+        <h2 id="continue-prayer-title">Escolha a primeira Hora do dia</h2>
+      </div>
+      <div>
+        {% if page.oficio_url %}<a class="button button--primary" href="{{ page.oficio_url | relative_url }}">Ofício das Leituras</a>{% endif %}
+        {% if page.laudes_url %}<a class="button button--primary" href="{{ page.laudes_url | relative_url }}">Laudes</a>{% endif %}
+      </div>
+    </section>
+    {% include share-buttons.html %}
