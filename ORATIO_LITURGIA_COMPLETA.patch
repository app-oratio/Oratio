+  }
+
+  .liturgy-hour-hero {
+    min-height: 0;
+    border: 0;
+    box-shadow: none;
+  }
+
+  .liturgy-hour-hero__media {
+    display: none;
+  }
+
+  .liturgy-reading-shell,
+  .liturgy-mass-section,
+  .liturgy-summary {
+    border: 0;
+    box-shadow: none;
+  }
+
+  .liturgy-reading-layout {
+    display: block;
+  }
+
+  .liturgy-reading__text,
+  .liturgy-mass__sections {
+    max-width: none;
+    font-size: 12pt !important;
+  }
+}
