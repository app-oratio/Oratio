+<nav class="liturgy-date-navigation" aria-label="Navegação entre os dias litúrgicos">
+  <div class="liturgy-date-navigation__adjacent">
+    {% if page.previous_day %}
+      {% assign previous_url = page.previous_day.daily_url %}
+      {% if include.target == 'hours_url' %}{% assign previous_url = page.previous_day.hours_url %}{% endif %}
+      <a class="button button--text button--small" href="{{ previous_url | relative_url }}" rel="prev" aria-label="Dia anterior: {{ page.previous_day.date_short }}">← {{ page.previous_day.date_short }}</a>
+    {% else %}<span></span>{% endif %}
+    {% if page.next_day %}
+      {% assign next_url = page.next_day.daily_url %}
+      {% if include.target == 'hours_url' %}{% assign next_url = page.next_day.hours_url %}{% endif %}
+      <a class="button button--text button--small" href="{{ next_url | relative_url }}" rel="next" aria-label="Dia seguinte: {{ page.next_day.date_short }}">{{ page.next_day.date_short }} →</a>
+    {% endif %}
+  </div>
+  <form class="liturgy-date-picker" data-liturgy-date-form>
+    <label for="liturgy-date-{{ include.id | default: 'main' }}">Escolher outro dia</label>
+    <div class="liturgy-date-picker__controls">
+      <input id="liturgy-date-{{ include.id | default: 'main' }}"
+        type="date"
+        value="{{ page.date_iso }}"
+        min="{{ page.available_days.first.date }}"
+        max="{{ page.available_days.last.date }}"
+        data-liturgy-date-picker
+        data-date-target="{{ include.target | default: 'daily_url' }}">
+      <button class="button button--primary button--small" type="submit">Abrir</button>
+    </div>
+    <p class="status-message" data-liturgy-date-status aria-live="polite"></p>
+  </form>
+</nav>
diff --git a/_includes/liturgy/dialogs.html b/_includes/liturgy/dialogs.html
