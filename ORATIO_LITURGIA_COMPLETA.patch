+        setTabState(buttons, panels, 'lat', 'data-language-select', 'data-language-panel');
+      });
+      setTabState(buttons, panels, ptPanel.style.display === 'none' ? 'lat' : 'pt', 'data-language-select', 'data-language-panel');
+    });
+  }
+
+  function initDialogs() {
