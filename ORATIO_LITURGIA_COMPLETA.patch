+++ b/_layouts/liturgy-day.html
@@ -0,0 +1,58 @@
+---
+layout: default
+---
+<div class="container container--large page-shell liturgy-shell liturgy-day" data-liturgy-page data-page-date="{{ page.date_iso }}">
+  {% include breadcrumb.html %}
+  <header class="liturgy-page-heading">
+    <div>
+      <p class="eyebrow">Liturgia diária</p>
+      <h1>{{ page.celebration }}</h1>
+      <p class="page-lead">Leituras, orações e Liturgia das Horas de {{ page.date_long }}.</p>
+    </div>
+    <a class="button button--text" href="{{ page.hours_day_url | relative_url }}">Ver somente a Liturgia das Horas</a>
+  </header>
+
+  {% include liturgy/liturgical-summary.html %}
+  {% include liturgy/date-navigation.html target='daily_url' id='daily' %}
+  <aside class="liturgy-current-callout" data-current-hour-callout hidden aria-live="polite"></aside>
+
+  {% if page.mass_sections and page.mass_sections.size > 0 %}
+  <section class="liturgy-mass" aria-labelledby="mass-title">
+    <div class="section-heading">
+      <p class="eyebrow">Celebração eucarística</p>
+      <h2 id="mass-title">Liturgia do dia</h2>
+      <p>Os textos abaixo seguem a ordem em que foram fornecidos no arquivo litúrgico.</p>
+    </div>
+    <nav class="liturgy-section-nav" aria-label="Partes da liturgia do dia">
+      {% for section in page.mass_sections %}<a href="#{{ section.anchor }}">{{ section.title }}</a>{% endfor %}
+    </nav>
+    <div class="liturgy-mass__sections" data-reading-text data-reading-font-base="1.075">
+      {% for section in page.mass_sections %}
+      <article class="liturgy-mass-section" id="{{ section.anchor }}">
+        <h3>{{ section.title }}</h3>
+        <div class="liturgy-prose">{{ section.html }}</div>
+      </article>
+      {% endfor %}
+    </div>
+  </section>
+  {% else %}
+    {% include empty-state.html title='Liturgia do dia indisponível' text='O arquivo liturgy.json desta data não possui seções publicáveis.' %}
+  {% endif %}
+
+  <section class="liturgy-hours-section" aria-labelledby="daily-hours-title">
+    <div class="section-heading section-heading--split">
+      <div>
+        <p class="eyebrow">Santificação do dia</p>
+        <h2 id="daily-hours-title">Liturgia das Horas</h2>
+        <p>O sistema destaca automaticamente a Hora mais indicada no momento.</p>
+      </div>
+      <a class="button button--text" href="{{ page.hours_day_url | relative_url }}">Abrir a página das Horas</a>
+    </div>
+    <div class="liturgy-hours-grid">
+      {% for hour in page.hours %}{% include liturgy/hour-card.html hour=hour day=page.date_iso %}{% endfor %}
+    </div>
+  </section>
+
+  {% include share-buttons.html %}
+  <script type="application/json" data-liturgy-days-json data-baseurl="{{ site.baseurl }}">{{ page.available_days | jsonify }}</script>
+</div>
diff --git a/_layouts/liturgy-hour.html b/_layouts/liturgy-hour.html
new file mode 100644
index 0000000..7fbf11d
--- /dev/null
+++ b/_layouts/liturgy-hour.html
@@ -0,0 +1,61 @@
+---
+layout: default
+---
+<div class="container container--large page-shell liturgy-shell liturgy-hour" data-liturgy-page data-page-date="{{ page.date_iso }}" data-page-hour="{{ page.hour_slug }}">
+  {% include breadcrumb.html %}
+  <article>
+    <header class="liturgy-hour-hero" style="--liturgical-accent: {{ page.liturgical.color_hex }}; --liturgical-on-accent: {{ page.liturgical.color_on }};">
+      <div class="liturgy-hour-hero__media">
+        {% if page.image contains '://' %}{% assign hour_image = page.image %}{% else %}{% assign hour_image = page.image | relative_url %}{% endif %}
+        <img src="{{ hour_image }}" alt="{{ page.image_alt | escape }}" width="960" height="640" loading="eager" data-liturgy-cover>
+      </div>
+      <div class="liturgy-hour-hero__content">
+        <p class="eyebrow">{{ page.hour_short_title }}</p>
+        <h1>{{ page.title }}</h1>
+        <p>{{ page.date_long }}</p>
+        <div class="liturgy-hour-hero__chips">
+          <span>{{ page.liturgical.season_label }}</span>
+          <span><i class="liturgy-color-dot" aria-hidden="true"></i>{{ page.liturgical.color_label }}</span>
+          {% if page.liturgical.psalter_label %}<span>{{ page.liturgical.psalter_label }}</span>{% endif %}
+          <span data-current-hour-badge hidden>Hora indicada agora</span>
+        </div>
+        <div class="liturgy-hour-hero__actions">
+          {% if page.invitatory_url %}<a class="button button--primary" href="{{ page.invitatory_url | relative_url }}">Começar pelo Invitatório</a>{% endif %}
+          <a class="button button--text" href="{{ page.hours_day_url | relative_url }}">Todas as Horas do dia</a>
+        </div>
+      </div>
+    </header>
+
+    <section class="liturgy-hour-summary" aria-label="Informações litúrgicas resumidas">
+      <strong>{{ page.celebration }}</strong>
+      <span>{{ page.liturgical.rank_label }}</span>
+      {% if page.liturgical.year_cycle != empty %}<span>{{ page.liturgical.year_cycle }}</span>{% endif %}
+      {% if page.liturgical.week_label %}<span>{{ page.liturgical.week_label }}</span>{% endif %}
+    </section>
+
+    <div class="liturgy-reading-shell" data-prayer-copy-source>
+      {% include reading-tools.html copy_label='Copiar esta Hora' %}
+      <div class="liturgy-reading-layout">
+        <aside class="liturgy-toc" data-liturgy-toc hidden>
+          <button type="button" class="liturgy-toc__toggle" data-liturgy-toc-toggle aria-expanded="false">Nesta Hora</button>
+          <nav data-liturgy-toc-list aria-label="Seções desta Hora"></nav>
+        </aside>
+        <div class="liturgy-reading__text liturgy-prose" data-reading-text data-reading-font-base="1.125">
+          {{ content }}
+        </div>
+      </div>
+      <p class="status-message" data-prayer-status aria-live="polite"></p>
+    </div>
+
+    <nav class="liturgy-hour-navigation" aria-label="Navegação entre as Horas">
+      {% if page.previous_hour %}<a href="{{ page.previous_hour.url | relative_url }}" rel="prev"><span>Hora anterior</span><strong>← {{ page.previous_hour.short_title }}</strong></a>{% else %}<span></span>{% endif %}
+      <a class="liturgy-hour-navigation__day" href="{{ page.daily_page_url | relative_url }}">Liturgia do dia</a>
+      {% if page.next_hour %}<a href="{{ page.next_hour.url | relative_url }}" rel="next"><span>Próxima Hora</span><strong>{{ page.next_hour.short_title }} →</strong></a>{% endif %}
+    </nav>
+
+    {% include share-buttons.html %}
+  </article>
+  {% include liturgy/dialogs.html %}
+  <aside class="liturgy-current-callout" data-current-hour-callout hidden aria-live="polite"></aside>
+  <script type="application/json" data-liturgy-days-json data-baseurl="{{ site.baseurl }}">{{ page.available_days | jsonify }}</script>
+</div>
