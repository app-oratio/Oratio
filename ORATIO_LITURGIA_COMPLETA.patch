+          {% if page.laudes_url %}<a class="button button--text" href="{{ page.laudes_url | relative_url }}">Ir às Laudes</a>{% endif %}
+        </div>
+      </div>
+    </header>
+
+    <div class="liturgy-reading-shell" data-prayer-copy-source>
+      {% include reading-tools.html copy_label='Copiar o Invitatório' %}
+      <div class="liturgy-reading__text liturgy-prose" data-reading-text data-reading-font-base="1.125">
