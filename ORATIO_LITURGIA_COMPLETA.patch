+}
+
+[data-theme="dark"] .liturgy-hour-card__current,
+[data-theme="dark"] .liturgy-hour-hero__chips > span[data-current-hour-badge] {
+  color: #3e2b00;
+}
+
+[data-theme="dark"] .liturgy-prose .rub,
+[data-theme="dark"] .liturgy-prose [class~="rub"] {
+  color: #efaaa5;
+}
+
+@media print {
+  .liturgy-date-navigation,
+  .liturgy-current-callout,
+  .liturgy-hours-section,
+  .liturgy-section-nav,
