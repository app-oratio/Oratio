+    if (!root) return;
+    var groups = [
+      { ptButton: 'btnPt', latButton: 'btnLat', ptPanel: 'pt', latPanel: 'lat' },
+      { ptButton: 'cantEvangBtnPt', latButton: 'cantEvangBtnLat', ptPanel: 'cantEvangPt', latPanel: 'cantEvangLat' }
