+
+    if (minutes < 180) {
+      date = previousIsoDate(date);
+      slug = 'completas';
+    } else if (minutes < 360) {
+      slug = 'oficio-das-leituras';
+    } else if (minutes < 510) {
+      slug = 'laudes';
+    } else if (minutes < 660) {
+      slug = 'hora-terca';
+    } else if (minutes < 810) {
+      slug = 'hora-sexta';
+    } else if (minutes < 960) {
+      slug = 'hora-nona';
